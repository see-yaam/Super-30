#include<stdio.h>
    int main(){
        int num,digit,product=1;
        printf("enter number:");
        scanf("%d",&num);
        
        while(num!=0){
            digit=num%10;
            product=product*digit;
            num=num/10;
            
            
        }
        
        printf("%d",product);
        return 0;
    }
