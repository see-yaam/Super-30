#include<stdio.h>
int main(){
    int lower,upper,num,temp,digit,digits,sum;
    printf("enter lower limit:");
    scanf("%d",&lower);
    
    printf("enter upper limit:");
    scanf("%d",&upper);
    
    
    
    
    for(num=lower;num<=upper;num++){
       temp=num;
       digits=0;
       sum=0;
      }
      
      while(temp!=0){
          digits++
          temp-temp/10;
      }
      temp=num;
      
      while(temp!=0){
          digit=temp%10;
          sum=sum+pow(digit,digits);
          temp=temp/10;
      }
        if(sum==num)
        {
            printf("%d",num);
        }
    }
    return 0;
}