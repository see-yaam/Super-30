#include<stdio.h>
#include<math.h>
int main(){
    int x,n,i;
    int power=1;
    int sign=1;
    
    float sum=0;
    
    printf("enter value of x:");
    scanf("%d",&x);
    
    printf("enter num of terms:");
    scanf("%d",&n);
    
    for(i=1;i<=n;i++){
        sum=sum+sign*pow(x,power);
        power=power+2;
        
        sign=-sign;
    }
    printf("sum=%.2f",sum);
    return 0;
   
}