#include<iostream>
using namespace std;
int main ()
{

    int n;
    cout << "Enter number: ";
    cin >> n;

    if (n>0)
    {
        for(int i=1; i<=10; i++)
        {
            cout << n << "x" << i << "=" << n*i << endl;
        }
    }
    else
    {
        cout <<  "Pleae enter a number greater than 0" ;
    }
    return 0;
}
