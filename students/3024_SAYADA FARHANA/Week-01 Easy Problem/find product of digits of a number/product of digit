#include<iostream>
using namespace std;
int main ()
{

    int n;
    int product=1,digit;
    cout << "Enter number: ";
    cin >> n;

    if (n==0)
    {
        product=0;
    }

    else
    {
        while (n!=0)
        {
            digit = n % 10;
            product = product * digit;
            n=n/10;
            ;
        }
    }
    cout << "product of digit = " << product ;


    return 0;
}
