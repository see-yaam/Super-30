#include<iostream>
#include<cmath>
using namespace std;

int main()
{
    int x, n;

    cout << "Enter x: ";
    cin >> x;

    cout << "Enter number of terms: ";
    cin >> n;

    int power = 1;
    int sign = 1;
    double sum = 0;

    for(int i = 1; i <= n; i++)
    {
        double term = pow(x, power);
        sum = sum + sign * term;
        power = power + 2;
        sign = sign * -1;
    }

    cout << "Sum of the series = " << sum;

          return 0;
}
