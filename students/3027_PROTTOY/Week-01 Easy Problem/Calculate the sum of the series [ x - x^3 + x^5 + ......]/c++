#include<iostream>
#include<math.h>
using namespace std;

int main()
{
    int n,x;
    cout<<"Enter the value of x: ";
    cin>>x;
    cout<<"Enter number of terms: ";
    cin>>n;
    
    double sum = 0;
        
    cout<<"The values of the series : "<<endl;
    
    for(int i=1;i<=n;i++)
    {
        int power = 2*i -1;
        int value = pow(x,power);
        
        if(i%2!=0)
        {
            cout<<value<<endl;
            sum = sum + pow(x,power);
        }
        else
        {
            cout<<-value<<endl;
            
            sum = sum - pow(x,power);
        }
        
    }
    
    cout<<"\n"<<"Sum of series upto "<< n << "terms: "<<sum;
}