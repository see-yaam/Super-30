#include<iostream>
using namespace std;

int main()
{
    int x,y;
    cout<<"Starting Range: ";
    cin>>x;
    cout<<"Ending range: ";
    cin>>y;
    
    cout<<"Perfect number within the given range: ";
    bool first = true;
    for(int i=x;i<=y;i++)
    {
        int sum = 0;
        for(int j=1;j<=i/2;j++)
        {
            if(i%j==0)
            {
                sum = sum + j;
            }
        }
        if (sum == i && i != 0) 
        {
            if(!first)
            {
                cout<<", ";
            }
            cout<<i;
            first = false;
        }
    }
    
}