#include <stdio.h>
int main(){
    int n, i;
    float sum = 0.0;

    printf("Enter number of terms: ");
    scanf("%d", &n);

    printf("Harmonic series: ");
    for(i = 1; i <= n; i++)
    {
        printf("1/%d", i);

        if(i < n)
            printf(" + ");

        sum = sum + (1.0 / i);
    }

    printf("\nSum = %.4f", sum);

    return 0;
}