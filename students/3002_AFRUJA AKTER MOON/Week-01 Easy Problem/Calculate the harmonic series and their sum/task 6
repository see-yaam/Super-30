#include <stdio.h>
int main()
{
    int n, i;
    float sum = 0.0;

    printf("Enter number of terms: ");
    scanf("%d", &n);

    printf("Harmonic Series: ");

    for(i = 1; i <= n; i++)
    {
        printf("1/%d ", i);
        sum = sum + (1.0 / i);
    }

    printf("\nSum of the harmonic series = %.2f\n", sum);

    return 0;
}
