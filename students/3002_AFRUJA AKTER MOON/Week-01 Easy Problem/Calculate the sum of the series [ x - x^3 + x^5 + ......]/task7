#include <stdio.h>
#include <math.h>

int main()
{
    int n, i;
    float x, sum = 0.0;
    int sign = 1;

    printf("Enter value of x: ");
    scanf("%f", &x);

    printf("Enter number of terms: ");
    scanf("%d", &n);

    for(i = 1; i <= n; i++)
    {
        sum = sum + sign * pow(x, (2*i - 1));
        sign = -sign;
    }

    printf("Sum of the series = %.2f\n", sum);

    return 0;
}
