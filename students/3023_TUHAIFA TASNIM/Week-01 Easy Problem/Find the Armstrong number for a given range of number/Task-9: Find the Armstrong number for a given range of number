#include<stdio.h>
int main ()
{
    int n,temp,rem;
    int sum=0;
    scanf("%d",&n);
    temp=n;
    while(temp!=0)
    {
        rem=temp%10;
        sum=sum+(rem*rem*rem);
        temp=temp/10;
    }
    if(n==sum)
    {
        printf("An Armstrong number");
    }
    else
    {
        printf("Not Armstrong ");
    }

    return 0;
}