#include <stdio.h>
#include <math.h>

int count(int n) {
    int c = 0;
    while (n != 0) {
        c++;
        n /= 10;
    }
    return c;
}

int arms(int n) {
    int digits = count(n);
    int temp = n;
    int sum = 0;

    while (temp != 0) {
        int digit = temp % 10;
        sum += (int)pow(digit, digits);
        temp /= 10;
    }

    return sum == n;
}

int main() {
    int lower, upper;

    printf("Input starting number of range: ");
    scanf("%d", &lower);

    printf("Input ending number of range  : ");
    scanf("%d", &upper);

    printf("\nArmstrong numbers in given range are: ");

    for (int i = lower; i <= upper; i++) {
        if (arms(i)) {
            printf("%d ", i);
        }
    }

    printf("\n");
    return 0;
}