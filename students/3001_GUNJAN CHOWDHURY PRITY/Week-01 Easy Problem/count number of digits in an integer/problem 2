#include <stdio.h>

int main()
{
    long long num;
    int count = 0;

    printf("Input num: ");
    scanf("%lld", &num);
    if(num == 0)
    {
        count = 1;
    }

   
    while(num != 0)
    {
        num = num / 10;   
        count++;
    }

    printf("Number of digits: %d\n", count);

    return 0;
}