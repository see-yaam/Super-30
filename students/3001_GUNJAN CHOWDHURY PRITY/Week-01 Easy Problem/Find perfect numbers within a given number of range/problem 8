#include <stdio.h>

int main() {
    int start, end, i, j, sum;

    printf("Enter starting number: ");
    scanf("%d", &start);

    printf("Enter ending number: ");
    scanf("%d", &end);

    printf("\nPerfect numbers between %d and %d are: ", start, end);

    for (i = start; i <= end; i++) {
        sum = 0;

        for (j = 1; j < i; j++) {
            if (i % j == 0) {
                sum += j;
            }
        }

        if (sum == i) {
            printf("%d ", i);
        }
    }

    printf("\n");

    return 0;
}